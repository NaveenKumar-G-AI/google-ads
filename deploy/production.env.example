# Non-secret production configuration only. Secrets belong in Secret Manager / Vercel encrypted env.
RECOVERY_ENVIRONMENT=production
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
API_ALLOWED_ORIGINS=https://app.example.com
BILLING_ENABLED=true
# Business-policy grace after a provider pending/payment-failure state. 0 disables grace.
BILLING_GRACE_HOURS=0
RECOVERY_BACKUP_POLICY_ACK=PITR_OR_DAILY_BACKUP_VERIFIED
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_SERVICE_ACCOUNT_JSON=/secrets/google-ads/service-account.json

# Self-serve Google Ads onboarding. Client ID/secret are supplied via Secret Manager in deployment scripts.
GOOGLE_ADS_OAUTH_REDIRECT_URI=https://app.example.com/api/google-ads/oauth/callback
GOOGLE_OAUTH_SECRET_MANAGER_PROJECT=YOUR_GCP_PROJECT
GOOGLE_ADS_OAUTH_VERIFICATION_ACK=RESTRICTED_SCOPE_VERIFIED

# Optional scheduled-report email delivery (worker only). Credentials belong in Secret Manager.
REPORT_SMTP_HOST=smtp.example.com
REPORT_SMTP_PORT=587
REPORT_SMTP_TLS_MODE=starttls
REPORT_SMTP_FROM=reports@example.com
# REPORT_SMTP_USERNAME and REPORT_SMTP_PASSWORD are secrets; do not place values in this file.

# V1 launch legal policy identities. Change these whenever published policy text changes.
RECOVERY_TERMS_URL=https://example.com/terms
RECOVERY_TERMS_VERSION=2026-10-16
RECOVERY_PRIVACY_URL=https://example.com/privacy
RECOVERY_PRIVACY_VERSION=2026-10-16
RECOVERY_DATA_DELETION_URL=https://example.com/data-deletion
RECOVERY_SUPPORT_EMAIL=support@example.com

# Public signup abuse controls. Site key is public; secret belongs in Secret Manager.
RECOVERY_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
RECOVERY_TURNSTILE_HOSTNAMES=app.example.com
RECOVERY_PUBLIC_WORKSPACE_MAX_PER_USER_24H=1
# RECOVERY_TURNSTILE_SECRET is a secret; do not place its value in this file.
